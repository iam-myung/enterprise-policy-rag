# 工程级 .gitignore（仓库根）

# ----- 运行产物（Git 忽略）-----
workspace/
artifacts/
logs/

# ----- 密钥与环境变量（保留 .env.example）-----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# ----- Python 缓存与构建 -----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/

# ----- 编辑器 / 系统 -----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# ----- 空壳遗留（仅忽略仓库根；勿写成无前缀，否则会误伤 src/enterprise_policy_rag/）-----
/enterprise_policy_rag/

# ----- 本地教学材料（不上仓库）-----
企业制度知识库_源码逆向教学手册.html

