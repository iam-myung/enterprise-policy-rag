# ============================================================
# 环境变量样例（只提交变量名与说明，禁止提交真实值）
# 复制为 .env 后按需填写；.env 已被 Git 忽略。
# ============================================================

# 运行环境：development / test / demo（必填）
APP_ENV=development

# API 监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite 连接串（指向新工程 workspace）
DATABASE_URL=sqlite:///workspace/database/enterprise_policy_rag.db

# 上传/解析/索引根目录（必须位于新工程 workspace/ 内）
WORKSPACE_ROOT=workspace

# DashScope / Qwen Provider 密钥（必填，禁止日志输出，禁止提交）
DASHSCOPE_API_KEY=

# 模型名（配置化，不写死业务代码）
EMBEDDING_MODEL=
RERANK_MODEL=
CHAT_MODEL=

# 上传大小上限（MiB，默认 20）
MAX_UPLOAD_MIB=20

# RAG 参数（评测记录实际值）
RAG_TOP_K=5
RAG_RRF_K=60
RAG_EVIDENCE_THRESHOLD=

# Provider / 请求超时（秒）
PROVIDER_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=45

# 是否保存脱敏后的问题预览（默认 false）
STORE_QUERY_PREVIEW=false

# 日志级别
LOG_LEVEL=INFO
