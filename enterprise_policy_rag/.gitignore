# 工程级 .gitignore（enterprise_policy_rag/ 内部）

# ----- 运行产物（Git 忽略）-----
workspace/
artifacts/

# ----- 密钥与环境变量（保留 .env.example）-----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# ----- Python 缓存与构建 -----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ----- 编辑器 / 系统 -----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
